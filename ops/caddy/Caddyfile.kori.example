# Caddyfile.kori.example — the ai.qouver.com and dash.qouver.com blocks for kori.
#
# This file is a TEMPLATE. deploy-vps.sh renders it to
#   /srv/qouver/apps/kori/caddy/site.caddy   (mode 0640, sachiel:caddy, httpd_sys_content_t)
# with the token placeholder replaced by the real bearer. /etc/caddy/Caddyfile then only carries
# one line, added once by Dimas:
#   import /srv/qouver/apps/kori/caddy/site.caddy
# The token never enters this repository.
#
# Facts this block is built on (EDGE-cloudflare.md, 2026-11-14, checked from outside):
#   - ai.qouver.com and dash.qouver.com already resolve to Cloudflare and Cloudflare already terminates client TLS.
#   - the origin behind it is this Caddy; it answers its own 404 today.
#   - Cloudflare SSL mode to origin must read Full (strict). Unverified from the origin side.
#
# qouver1 runs SELinux Enforcing and Caddy as httpd_t: files Caddy imports from /srv need
# httpd_sys_content_t, otherwise Caddy exits 1 with "File to import not found" and no journal
# line. And /etc/caddy/Caddyfile sets `admin off`, so `caddy reload` always fails: apply with
# `systemctl restart caddy`.

ai.qouver.com {
	log {
		import log_access
	}

	# Cloudflare's published ranges, listed literally. A stale list fails closed (the peer is
	# not trusted, the request is refused), which is the direction we want. Refreshed at deploy
	# from cloudflare.com/ips-v4 and ips-v6 — a manual step until it is scripted.
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
		141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
		198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 \
		131.0.72.0/22 \
		2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 \
		2a06:98c0::/29 2c0f:f248::/32

	# Fail closed: a peer outside the ranges is not the proxy, so it is refused outright rather
	# than admitted with a spoofable CF-Connecting-IP bucket.
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
		141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
		198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 \
		131.0.72.0/22 \
		2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 \
		2a06:98c0::/29 2c0f:f248::/32
	respond @not_cloudflare "direct origin access is not allowed" 403

	# `servers { trusted_proxies ... client_ip_headers CF-Connecting-IP }` is a GLOBAL option in
	# Caddy: it belongs in the options block at the top of /etc/caddy/Caddyfile, not in a site
	# block. Written here it was `unrecognized directive: servers` at adapt time, and the restart
	# that carried it took every site on qouver1 down (2026-11-16). The global block is Dimas's
	# file, so the change is his call, not a deploy side effect.
	# It is not needed for the gate below: Cloudflare connects to this origin directly, so
	# `remote_ip` already sees the Cloudflare edge address. Without it, the request log records
	# that edge address instead of the real client; per-IP limiting lives at Cloudflare anyway.

	# The host's shared header snippet. Every other site on qouver1 imports it; kori did not, so
	# the origin answered with no HSTS, no X-Frame-Options and no Referrer-Policy at all
	# (measured 2026-11-21: `curl -D- https://ai.qouver.com/v1/models` returned only
	# content-type/cache-control, while api.qouver.com returned the full set). Cloudflare
	# forwards what the origin sends, so this is the only place the headers can come from.
	import security

	encode zstd gzip

	# Bearer gate. One token, one caller, one bill — there is no second password anywhere.
	@no_bearer not header Authorization "Bearer __KORI_EDGE_TOKEN__"
	respond @no_bearer "unauthorized" 401

	# The dashboard and the scrape surface are loopback-only by decision (EDGE §3.7). Refused at
	# the edge so a mistake inside the binary cannot expose them.
	@admin path /admin /admin/* /metrics
	respond @admin "not found" 404

	# Rate limit per real client IP. Needs the caddy-ratelimit module, which is NOT in a stock
	# Caddy build: qouver1 runs the RPM binary (v2.11.9, 138 modules, no ratelimit), so this block
	# stays commented until that binary is replaced, and that swap is a shared-edge window.
	# Measured 2026-11-26: 620 requests from one IP, all wrong-bearer, returned 401 and not one 429,
	# and no Cloudflare rule existed either. So the edge currently has no per-IP limit: the bearer
	# is the only gate. Interim decision (Bagas, 2026-11-26) is a Cloudflare rate-limiting rule,
	# 60/min per IP on ai.qouver.com, which needs no host change; the module build is the
	# belt-and-braces path after that.
	# rate_limit {
	# 	zone kori_ip {
	# 		key {client_ip}
	# 		events 60
	# 		window 1m
	# 	}
	# 	respond "too many requests" 429
	# }

	# No caching, ever: every path is an API path or a 404.
	header Cache-Control "no-store"

	reverse_proxy 127.0.0.1:8787 {
		# SSE must not be buffered. Anything that holds a token stream for ten seconds is a bug,
		# not a slow provider.
		flush_interval -1
		# Long body deadline: a 200k-token completion can stream for minutes. The binary enforces
		# its own six deadlines (D2); Caddy must be the looser of the two or it cuts legs that are
		# working.
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}
}

dash.qouver.com {
	log {
		import log_access
	}

	# Fail closed: only accept traffic proxied through Cloudflare.
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
		141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
		198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 \
		131.0.72.0/22 \
		2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 \
		2a06:98c0::/29 2c0f:f248::/32
	respond @not_cloudflare "direct origin access is not allowed" 403

	# Same shared snippet as the ai block, for the same reason: the dashboard is a page a browser
	# loads, so `X-Frame-Options` and `Referrer-Policy` matter here most. Measured 2026-11-21:
	# dash answered /login.html with only date/content-type/cache-control/vary/via/x-content-type,
	# no HSTS and nothing that stops the page being framed.
	import security

	encode zstd gzip

	# Chat completions API is strictly for ai.qouver.com with bearer token; keep it blocked here.
	@api path /v1 /v1/*
	respond @api "not found" 404

	# /healthz answered {"status":"ok","version":...,"revision":...} to anyone, no credential
	# (measured 2026-11-26). Both the readyz timer and the deploy health gate probe
	# 127.0.0.1:8787 directly, past this proxy, so the public edge has no reason to answer it.
	# Applied live on qouver1 first; this keeps it across the next re-render.
	@probe path /healthz
	respond @probe "not found" 404

	# Dashboard UI and /admin/* read endpoints are reverse-proxied to kori on loopback.
	reverse_proxy 127.0.0.1:8787
}
