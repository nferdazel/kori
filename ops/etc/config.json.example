{
  "listen": { "host": "127.0.0.1", "port": 8787 },
  "log": { "path": "/var/log/kori/requests.jsonl" },
  "balance": false,
  "legs": [
    {
      "name": "opencode-go",
      "base_url": "https://opencode.ai/inference/go/openai/v1",
      "model": "deepseek-v4.1-flash",
      "role": "primary",
      "headers": { "x-opencode-session": "__KORI_OPENCODE_SESSION__" },
      "oauth": {
        "token_url": "https://opencode.ai/console/auth/oauth/token",
        "client_id": "https://opencode.ai/oauth/opencode/client.json",
        "refresh_token": "__KORI_OPENCODE_REFRESH_TOKEN__",
        "access_token": "__KORI_OPENCODE_ACCESS_TOKEN__"
      }
    },
    {
      "name": "commandcode",
      "base_url": "https://api.commandcode.ai/provider/v1",
      "role": "fallback",
      "api_key": "__KORI_COMMANDCODE_API_KEY__"
    },
    {
      "name": "sinarcloud",
      "base_url": "https://ai.sinarcloud.com/v1",
      "role": "fallback",
      "api_key": "__KORI_SINARCLOUD_API_KEY__"
    }
  ]
}
