# kori-prod.env.example — template only. The real file lives on the host at
# /srv/qouver/apps/kori/env/kori-prod.env, mode 0600, owned by the deploy user.
#
# Read by both the deploy script (sourced) and the Quadlet unit (EnvironmentFile=).
# No provider credential belongs here: those live in /etc/kori/config.json (mounted read-only).

# Absolute app root on the host.
KORI_APP_DIR=/srv/qouver/apps/kori

# Loopback port. EDGE-cloudflare.md fixes the default at 8787; Gilang can change it, and if he
# does, this value, the unit's PublishPort and the smoke script's default move together.
KORI_PORT=8787

# Image name without a tag. Only :local and :prev ever exist.
KORI_IMAGE=localhost/kori

# Quadlet service name.
KORI_SERVICE=kori-api

# Health probe. /admin/state is the only endpoint the spec guarantees answers on a fresh start
# (every leg `unknown`, 200). If Gilang adds a dedicated /readyz, switch this line and nothing else.
KORI_HEALTH_URL=http://127.0.0.1:8787/admin/state

# Bearer the edge requires. Generated once on the host, never in a repo, never in a log:
#   openssl rand -hex 32
KORI_EDGE_TOKEN=

# Optional: set only when smoke.sh should also test the public door.
# KORI_EDGE_URL=https://ai.qouver.com
