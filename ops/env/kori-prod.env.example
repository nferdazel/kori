# kori-prod.env.example — template only. The real file lives on the host at
# /srv/qouver/apps/kori/env/kori-prod.env, mode 0600, owned by the deploy user.
#
# Read by both the deploy script (sourced) and the Quadlet unit (EnvironmentFile=).
# No provider credential belongs here: those live in /etc/kori/config.json, whose directory the
# unit mounts writable because the OAuth refresh rewrites the token in place (temp file in the
# same directory, then rename). The file itself stays 0600.

# Absolute app root on the host.
KORI_APP_DIR=/srv/qouver/apps/kori

# Loopback port. EDGE-cloudflare.md fixes the default at 8787; Gilang can change it, and if he
# does, this value, the unit's PublishPort and the smoke script's default move together.
KORI_PORT=8787

# Image name without a tag. Only :local and :prev ever exist.
KORI_IMAGE=localhost/kori

# Quadlet service name.
KORI_SERVICE=kori-api

# Health probe for the deploy gate. /healthz stays open with no credential by design (DEC-20),
# so the gate never needs the admin token to learn that a container is up. Do NOT point this at
# /admin/state: that surface answers 404 without a token, and a 404 here rolls every deploy back.
# /healthz?deep is gated and is not a probe target.
KORI_HEALTH_URL=http://127.0.0.1:8787/healthz

# Admin surface gate (DEC-20). One shared token, read per request, so a rotation needs no restart.
#
# The path is the one INSIDE the container, not the host path. This file becomes the container's
# process environment (Quadlet EnvironmentFile=), and the unit mounts
# /srv/qouver/apps/kori/etc at /etc/kori:rw,Z, so the host file
# /srv/qouver/apps/kori/etc/admin.token is what /etc/kori/admin.token resolves to there. Writing
# the host path here would point the binary at a directory that does not exist in the container
# and every gated surface would 404 — which is fail-closed, but silently and for the wrong reason.
# The line is set explicitly only so this file documents the knob; /etc/kori/admin.token is
# already the binary's default.
KORI_ADMIN_TOKEN_FILE=/etc/kori/admin.token

# The token itself is NOT here. It is created once on the host, outside git, outside this file:
#   install -d -m 0700 /srv/qouver/apps/kori/etc
#   umask 077; openssl rand -hex 32 > /srv/qouver/apps/kori/etc/admin.token
# chmod 600, owner = the deploy user. Missing or empty file means every gated surface answers 404
# (DEC-20 point 2), so an absent file is safe but leaves the dashboard dark.
#
# No copy of the token goes in this file, under any name: this file becomes the container's process
# environment, so a value here is readable from inside the container and from /proc on the host for
# as long as the service runs. smoke.sh reads the token from $APP_DIR/etc/admin.token itself, which
# is why the authenticated checks in the release gate need nothing set here. (Galih, 2026-11-19.)
#
# Rotating the token is the file in place plus `systemctl --user restart kori-api`: the new value is
# read per request for new logins, but sessions already issued are checked against the session table,
# not the current token, so they survive until they expire or the process restarts.

# Bearer the edge requires. Generated once on the host, never in a repo, never in a log:
#   openssl rand -hex 32
KORI_EDGE_TOKEN=

# Optional: set only when smoke.sh should also test the public door.
# KORI_EDGE_URL=https://ai.qouver.com
