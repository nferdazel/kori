# Quadlet unit — kori-api (Nim gateway, rootless podman + systemd user).
# Install at ~/.config/containers/systemd/kori-api.container
#   systemctl --user daemon-reload && systemctl --user restart kori-api
#
# Notes that are deliberate, each one paid for on another app on this host:
#   - `PublishPort=127.0.0.1:8787:8787`: the host exposes loopback only. Inside the container
#     the binary must listen on 0.0.0.0, because rootless podman forwards from the bridge
#     address (10.89.0.x); binding 127.0.0.1 inside leaves the container alive and unreachable.
#     The spec's "never 0.0.0.0" is satisfied by the publish address, not by the in-container
#     bind — this is the one place the wording and the runtime disagree (OPS-SHIP §4.1).
#   - `ReadOnly=true` + `Tmpfs=/tmp`: the gateway writes exactly two things, the append-only
#     request log and stdout. The log is a bind mount; a write to the rootfs is a bug and should
#     fail the container, not fill a layer.
#   - The config DIRECTORY is mounted writable, and the file inside it stays 0600, outside every
#     repo. It holds every provider credential, so it is never baked into an image. It cannot be
#     a single-file bind: the OAuth refresh rewrites the token atomically (temp in the same dir,
#     then rename), and a rename into a bind-mounted file fails even at :rw. Mounting the file
#     read-only made every refresh succeed in memory and persist nowhere, so a container restart
#     went back to the seed token.
#   - `:Z` (private label), not `:z`: this directory is the only place provider credentials exist
#     on the host. A shared label lets any other container on qouver1 carry the same category and
#     read it; a private one is relabelled for this container alone.
#   - No HealthCmd: the runtime image has no curl or wget, and podman healthchecks run inside the
#     container. Health is `Restart=always` plus the deploy gate on /healthz, which stays open with
#     no credential (DEC-20). The gate must never depend on /admin/state: that surface answers 404
#     without a token file, so a probe there would fail every deploy and roll it back.
#   - `OnFailure=alert@%N.service`: the host's Telegram alert with a 15-minute per-unit cooldown,
#     the same wiring the other units carry. A unit that dies repeatedly and silently is the
#     failure this host already paid for once.
#   - No `Network=qouver`: kori talks to upstream providers and has no database, so it does not
#     need to see the app network.
#   - Split stop budget, outer ring wider than inner: the binary drains in-flight requests for at
#     most 5s (ShutdownDrainMs), podman gives the container 15s (StopTimeout=15, inserted into
#     [Container] by deploy-vps.sh because quadlet only honours that key from podman 4.4), and
#     systemd gives the unit 25s (TimeoutStopSec). A normal stop ends at the innermost ring, so a
#     stop that ever reaches a kill is the bug the drain exists to prevent.

[Unit]
OnFailure=alert@%N.service
Description=kori — in-house LLM gateway (Nim)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/kori:local
ContainerName=kori-api
# The image drops to uid 10001 (apps/api/Dockerfile:60), and a rootless container's 10001 is a
# subuid on the host, so a 0600 config owned by sachiel is unreadable and the unit dies at start
# with "cannot read config '/etc/kori/config.json'" (measured 2026-11-16, first deploy). keep-id
# maps host sachiel to 10001 inside, so the bind mount is readable and the OAuth rewrite stays
# writable. Same line kran-api and majadu-api carry.
UserNS=keep-id:uid=10001,gid=10001
PublishPort=127.0.0.1:8787:8787
Pull=never
AutoUpdate=local
EnvironmentFile=/srv/qouver/apps/kori/env/kori-prod.env
Volume=/srv/qouver/apps/kori/etc:/etc/kori:rw,Z
Volume=/srv/qouver/apps/kori/logs:/var/log/kori:z
Exec=--config=/etc/kori/config.json --port=8787 --address=0.0.0.0 --log=/var/log/kori/requests.jsonl
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:size=32m
PidsLimit=128

[Service]
Restart=always
# Exit 2 is "bad config" — a permanent condition; restarting just repeats it and hides the cause.
RestartPreventExitStatus=2
RestartSec=3
# Split stop budget, outer to inner: 25s here > podman's StopTimeout=15 > the binary's own 5s
# drain. Each ring is wider than the one it wraps, so a healthy stop finishes inside the drain.
TimeoutStopSec=25
# The 143 success-exit-status override is deliberately NOT used: podman's SIGKILL surfaces as
# 137, and 137 has to keep failing the unit so OnFailure=alert@%N.service still fires. A stop
# that needed a kill is a bug in the drain, not a normal stop.
PrivateTmp=true
# Leak guard, not a measurement. A gateway with one upstream per request should sit in the
# tens of MB; 512M means a leak or an unbounded buffer.
MemoryMax=512M

[Install]
WantedBy=default.target
